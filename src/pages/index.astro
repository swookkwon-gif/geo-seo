---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config/site';
import { buildWebSiteJsonLd } from '../utils/jsonld';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const siteUrl = Astro.site?.toString() || SITE.url;
const jsonLd = buildWebSiteJsonLd(siteUrl);
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <span class="hero-eyebrow">GEO &amp; Search Architecture Research</span>
      <h1>{SITE.title}</h1>
      <p>{SITE.description}</p>
    </section>

    <div class="post-grid" id="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
