---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE } from '../../config/site';
import { buildBreadcrumbJsonLd } from '../../utils/jsonld';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
}

const { tag, posts } = Astro.props;
const siteUrl = Astro.site?.toString() || SITE.url;
const jsonLd = buildBreadcrumbJsonLd(
  [
    { name: '홈', url: '/' },
    { name: `#${tag}`, url: `/tags/${encodeURIComponent(tag)}/` },
  ],
  siteUrl
);
---

<BaseLayout
  title={`#${tag}`}
  description={`'${tag}' 주제와 관련된 논문 리뷰, 도서 노트, 연구 단상 모음`}
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="hero">
      <span class="hero-eyebrow">Tag Archive</span>
      <h1>#{tag}</h1>
      <p>총 {posts.length}건의 연구 노트가 있습니다.</p>
    </section>

    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
