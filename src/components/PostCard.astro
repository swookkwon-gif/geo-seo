---
import { SITE } from '../config/site';
import { formatDateKo, type PostEntry } from '../utils/posts';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { data } = post;
const categoryLabel = SITE.categories[data.category].label;
---

<article
  class="post-card"
  data-category={data.category}
  data-search={`${data.title} ${data.description} ${data.tldr || ''} ${data.tags.join(' ')}`.toLowerCase()}
>
  <div class="post-card-meta">
    <span class={`badge badge-${data.category}`}>{categoryLabel}</span>
    <time datetime={data.publishedAt.toISOString()}>
      {formatDateKo(data.publishedAt)}
    </time>
  </div>

  <h2>
    <a href={`/${post.id}/`}>{data.title}</a>
  </h2>

  <p class="post-card-desc">{data.tldr || data.description}</p>
</article>
