---
import { SITE } from '../config/site';
import { estimateReadingMinutes, formatDateKo, type PostEntry } from '../utils/posts';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { data } = post;
const categoryLabel = SITE.categories[data.category].label;
const readingMinutes = estimateReadingMinutes(post.body);
---

<article
  class="post-card"
  data-category={data.category}
  data-search={`${data.title} ${data.description} ${data.tldr || ''} ${data.tags.join(' ')}`.toLowerCase()}
>
  <div class="post-card-meta">
    <span class={`badge badge-${data.category}`}>{categoryLabel}</span>
    <span>
      <time datetime={data.publishedAt.toISOString()}>
        {formatDateKo(data.publishedAt)}
      </time>
      · {readingMinutes}분 읽기
    </span>
  </div>

  <h2>
    <a href={`/posts/${post.id}/`}>{data.title}</a>
  </h2>

  <p class="post-card-desc">{data.tldr || data.description}</p>

  {data.tags.length > 0 && (
    <ul class="tag-list" aria-label="태그">
      {data.tags.slice(0, 4).map((tag) => (
        <li>
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        </li>
      ))}
    </ul>
  )}
</article>
