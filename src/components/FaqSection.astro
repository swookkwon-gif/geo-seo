---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-section" aria-label="자주 묻는 질문">
    <h2>자주 묻는 질문 (FAQ)</h2>
    {items.map((item) => (
      <div class="faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
)}
