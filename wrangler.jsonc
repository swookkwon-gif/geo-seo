{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-seo-research",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
